import os
import sys
import shlex

def _start_umaps_early():
    """Start the umaps warm-up now, in the main snakemake process only; rule umaps
    attaches to it. Returns without effect for dry runs, lint, listings and jobs."""
    if "PANAGRAM_UMAPS_CONTROL" in os.environ or workflow.dryrun:
        return None
    skip = {"-n", "--dry-run", "--dryrun", "--lint", "--list", "-l", "--summary", "-S",
        "--list-target-rules", "--list-rules", "--dag", "--rulegraph", "--filegraph",
        "--d3dag", "--detailed-summary", "-D", "--containerize", "--unlock", "--cleanup-metadata"}
    if any(a.split("=")[0] in skip for a in sys.argv[1:]):
        return None
    import subprocess
    import tempfile
    control = tempfile.mkdtemp(prefix="panagram-umaps-")
    os.environ["PANAGRAM_UMAPS_CONTROL"] = control
    try:
        proc = subprocess.Popen([sys.executable, "-m", "panagram._umaps_job", "--early", control],
            stdout=open(os.path.join(control, "log.txt"), "w"), stderr=subprocess.STDOUT)
        with open(os.path.join(control, "pid"), "w") as f:
            f.write(str(proc.pid))
    except Exception:
        return None

    def _cleanup():
        # Whatever way snakemake ends (nothing to do, an error, success), the head-start
        # must not outlive it or leave its control directory behind.
        import shutil
        if proc.poll() is None:
            proc.terminate()
        shutil.rmtree(control, ignore_errors=True)

    import atexit
    atexit.register(_cleanup)
    return control

_UMAPS_CONTROL = _start_umaps_early()

import pandas as pd
from snakemake.exceptions import WorkflowError
from panagram.index import Index
from panagram.index import EXTRA_DIR

configfile: "config.yaml"

index = Index(".", mode="w")
index.load_config()

UMAP_GENOMES = list(dict.fromkeys(index.anchor_genomes))
SAMPLES = index.samples #pd.read_table(config["samples"]).set_index("name")

TMPDIR = f"tmp/"
KMC_EXTS = ["kmc_pre","kmc_suf"]

def get_fasta(wildcards):
    f = SAMPLES.loc[wildcards.sample, "fasta"]
    return f

def get_fai(wildcards):
    return get_fasta(wildcards)+".fai"

def get_genome_id(wildcards):
    f = SAMPLES.loc[wildcards.sample, "id"]
    return f

def get_onehot_tag(wildcards):
    i = SAMPLES.index.get_loc(wildcards.sample) % 32
    return 1 << i

def get_anchor_mb(wc,input):
    return 1+(1.5*input.size_mb)

rule anchor:
    input:
        kmc_pre=expand("kmc/bitvec{i}.kmc_pre", i=range(index.kmc_bitvec_count)),
        kmc_suf=expand("kmc/bitvec{i}.kmc_suf", i=range(index.kmc_bitvec_count)),
        fasta=get_fasta,
    output:
        expand("anchor/{{sample}}/bitmap.{step}.{ext}", step=index.steps, ext=["gz","gzi"]),
        "anchor/{sample}/chrs.tsv",
    log:
        log="logs/anchor.{sample}.log.txt"
    benchmark:
        "logs/anchor.{sample}.benchmark.txt"
    resources:
        mem_mb=get_anchor_mb,
    run:
        failed = f"anchor/{wildcards.sample}/failed"
        if os.path.exists(failed):
            os.remove(failed)
        try:
            index[wildcards.sample].run_anchor(index.bitvec_prefixes, log.log, umaps=False)
        except BaseException:
            open(failed, "w").close()
            raise
        if os.path.exists(failed):
            os.remove(failed)

rule umaps:
    input:
        expand("anchor/{sample}/chrs.tsv", sample=UMAP_GENOMES),
    output:
        expand("anchor/{sample}/chrom_umaps.csv", sample=UMAP_GENOMES),
        expand("anchor/{sample}/genome_umap.csv", sample=UMAP_GENOMES),
    threads: 0
    shell:
        f'"{sys.executable}" -m panagram._umaps_job --attach'

def get_bitvec_mb(wc,input):
    dbsize = input.size_mb #max([d.size_mb for d in input.dbs])
    return 1 + dbsize

rule kmc_bitvec:
    input:
        dbs=expand("kmc/{sample}.onehot.{ext}", sample=list(SAMPLES.index), ext=KMC_EXTS)
    output:
        expand("kmc/bitvec{{i}}.{ext}", ext=KMC_EXTS),
        opdef="kmc/opdef{i}.txt"
    params:
        opdef_text=lambda wc: shlex.quote(index.opdef_texts()[int(wc.i)])
    log:
        "logs/kmc.bitvec{i}.log.txt"
    benchmark:
        "logs/kmc.bitvec{i}.benchmark.txt"
    resources:
        mem_mb=get_bitvec_mb,
    threads: 2
    shell:
        f"printf '%s' {{params.opdef_text}} > {{output.opdef}}; "
        f"{EXTRA_DIR}/kmc_tools complex {{output.opdef}} > {{log}} 2>&1"

def get_kmc_threads():
    # workflow.cores raises when snakemake got no --cores (--unlock, or a run it will refuse
    # after parsing); the threads value is then the configured one, as before.
    try:
        cores = workflow.cores
    except WorkflowError:
        return config["kmc"]["threads"]
    return max(1, min(config["kmc"]["threads"], cores // max(1, len(SAMPLES))))

rule kmc_count:
    input:
        get_fasta #"{fasta}"
    output:
        expand("kmc/{{sample}}.{db}.{ext}", db=["count","onehot"], ext=KMC_EXTS)
    params:
        tag = get_onehot_tag,
        ci=lambda wc, input: "-ci2" if str(input[0]).endswith((".fastq", ".fastq.gz", ".fq", ".fq.gz")) else "-ci1",
        input_flag = lambda wc, input: "-fq" if str(input[0]).endswith((".fastq", ".fastq.gz", ".fq", ".fq.gz")) else "-fm"
    log:
        "logs/kmc.{sample}.txt"
    benchmark:
        "logs/kmc.{sample}.benchmark.txt"
    threads: get_kmc_threads()
    resources:
        mem_mb=500+config["kmc"]["memory"]*1000,
    shell:
        """
        mkdir -p {TMPDIR}{wildcards.sample}

        {EXTRA_DIR}/kmc -k{config[k]} -t{threads} -m{config[kmc][memory]} \
            {params.ci} -cs1000 {params.input_flag} {input} \
            kmc/{wildcards.sample}.count {TMPDIR}{wildcards.sample} \
            > {log} 2>&1

        {EXTRA_DIR}/kmc_tools -t{threads} transform \
            kmc/{wildcards.sample}.count set_counts {params.tag} \
            kmc/{wildcards.sample}.onehot \
            >> {log} 2>&1
        """

rule faidx:
    input:
        "{fasta}"
    output:
        "{fasta}.fai"
    log:
        "logs/faidx.{fasta}.log.txt"
    benchmark:
        "logs/faidx.{fasta}.benchmark.txt"
    shell:
        "samtools faidx {input} > {log} 2>&1"

rule mash_sample:
    input:
        get_fasta
    output:
        "tmp/{sample}.msh"
    log:
        "logs/mash.sketch.{sample}.log.txt"
    benchmark:
        "logs/mash.sketch.{sample}.benchmark.txt"
    shell:
        "{EXTRA_DIR}/mash "
        "sketch -C {wildcards.sample} -o tmp/{wildcards.sample}.msh -r -s 10000 {input} "
        "> {log} 2>&1;"

rule mash_triangle:
    input:
        expand("tmp/{sample}.msh", sample=SAMPLES.index)
    output:
        "genome_dist.tsv"
    log:
        "logs/mash.triangle.log.txt"
    benchmark:
        "logs/mash.triangle.benchmark.txt"
    shell:
        "{EXTRA_DIR}/mash "
        "triangle -C -E {input} > {output} 2> {log}"

rule all:
    input:
        "genome_dist.tsv",
        expand("anchor/{sample}/chrs.tsv", sample=index.anchor_genomes),
        expand("anchor/{sample}/chrom_umaps.csv", sample=index.anchor_genomes),
        expand("anchor/{sample}/genome_umap.csv", sample=index.anchor_genomes)

if _UMAPS_CONTROL:
    # Snakefile parsed: release the head-start process, so its UMAPs overlap the anchor jobs.
    try:
        open(os.path.join(_UMAPS_CONTROL, "go"), "w").close()
    except OSError:
        pass
